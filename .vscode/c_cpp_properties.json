{
    "configurations": [
        {
            "name": "DOS16",
            "includePath": [
                "${workspaceFolder}/src/**",
                "~/develop/open-watcom-v2/rel/h/**"
            ],
            "defines": [
                "${defaultDefines}",
                "__I86__"
            ],
            "cStandard": "c89",
            "cppStandard": "c++98",
            "intelliSenseMode": "gcc-x86",
            "configurationProvider": "ms-vscode.makefile-tools",
        },
        {
            "name": "DOS32",
            "includePath": [
                "${workspaceFolder}/src/**",
                "~/develop/open-watcom-v2/rel/h/**"
            ],
            "defines": [
                "${defaultDefines}",
                "__386__"
            ],
            "cStandard": "c89",
            "cppStandard": "c++98",
            "intelliSenseMode": "gcc-x86",
            "configurationProvider": "ms-vscode.makefile-tools",
            "compilerPath": "~/develop/open-watcom-v2/rel/binl/wcl386",
            "compilerArgs": [
                "-bt=DOS",
                "-fe=bin/main.exe"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/src/**",
                    "~/develop/open-watcom-v2/rel/h/**",
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "env": {
        "defaultDefines": [
            "__X86__",
            "M_I86",
            "_M_I86",
            "_M_IX86=0",
            "__DOS__",
            "_DOS",
            "MSDOS",
            "__SMALL__=1",
            "_M_I86SM=__SMALL__",
            "M_I86SM=__SMALL__",
            "__cplusplus=1",
            "__WATCOMC__=1300",
            "_INTEGRAL_MAX_BITS=32",
            "_PUSHPOP_SUPPORTED=1",
            "__near=",
            "__watcall=",
            "far=",
            "interrupt=",
            "_interrupt=",
            "__interrupt=",
            "__far=",
            "_dos_getvect(x)=0",
            "_chain_intr(x)=0",
            "asm=__asm",
            "__declspec(x)=",
            "__cdecl="
        ]
    },
    "diagnostics": {
        "suppress": [
            "unrecognizedToken",
            "unicodeIdentifier"
        ]
    },
    "version": 4,
    "enableConfigurationSquiggles": false
}